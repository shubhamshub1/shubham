{
    "compilerOptions": {
        "target": "es2022",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "outDir": "dist",
        "rootDir": "src",
        "types": [
            "node",
            "emscripten"
        ],
        "strict": true,
        "sourceMap": true,
        "skipLibCheck": true
    },
    "include": [
        "./**/*"
    ],
    "exclude": [
        "./test",
        "./node_modules",
        "./dist"
    ]
}